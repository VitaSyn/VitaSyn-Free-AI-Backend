# Phone sign-in currently uses the fixed development OTP 123456.
# Replace the backend implementation with Twilio Verify when ready.

# Twilio Verify service configuration for future phone OTP delivery
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Clerk server key for verifying Google/Apple sign-in sessions
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key

# SMTP credentials for email sign-in OTPs (use an app password where required)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASS=your_email_app_password
